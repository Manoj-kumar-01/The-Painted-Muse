<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Overview | The Painted Muse</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&family=Outfit:wght@400;500;700&family=Great+Vibes&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="components/DashboardNavbar.js" defer></script>
    <style>
        :root {
            --primary: #B5451B;
            --accent: #D4AF37;
            --background: #FDFBF7;
            --text: #1A1208;
            --cream: #F5F0E8;
            --warm: #FFF8F0;
        }
        .material-symbols-outlined {
            font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24
        }
        body {
            background-color: var(--background);
            color: var(--text);
            font-family: 'Outfit', sans-serif;
        }
        .font-serif { font-family: 'Cormorant Garamond', serif; }
        .font-calligraphy { font-family: 'Great Vibes', cursive; }
        
        .ink-grain {
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
            opacity: 0.04;
            pointer-events: none;
            position: fixed;
            inset: 0;
            z-index: 99;
        }

        .warli-border {
            border: 1px solid rgba(212, 175, 55, 0.2);
            position: relative;
        }
        .warli-border::before {
            content: "";
            position: absolute;
            inset: 4px;
            border: 1px solid rgba(212, 175, 55, 0.1);
            pointer-events: none;
        }
        
        .glass-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(212, 175, 55, 0.1);
        }

        @keyframes pageFadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        main > div {
            animation: pageFadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(26, 18, 8, 0.05); }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 10px; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="min-h-[100dvh] flex flex-col bg-gradient-to-br from-[#FDFBF7] via-[#F5F0E8] to-[#E8E4D9] relative">
    <dashboard-navbar type="user"></dashboard-navbar>
    <div class="ink-grain"></div>
        
    <main class="flex-1 w-full overflow-y-auto custom-scrollbar relative">
        <div class="p-6 md:p-10 space-y-10 max-w-7xl mx-auto w-full">
                <section class="relative overflow-hidden rounded-3xl bg-stone-900 p-12 text-white shadow-2xl">
                    <div class="absolute inset-0 opacity-20 pointer-events-none bg-cover bg-center" style="background-image: url('pics/madhubani_bg.png')"></div>
                    <div class="absolute inset-0 bg-gradient-to-r from-stone-900 via-stone-900/80 to-transparent"></div>
                    <div class="relative z-10 max-w-2xl">
                        <span class="font-calligraphy text-4xl text-[#D4AF37] mb-2 block">Namaste, <%= user ? user.fullName.split(' ')[0] : 'Collector' %>!</span>
                        <h1 class="text-4xl md:text-5xl font-serif mb-6 leading-tight">Your Journey into <br><span class="italic font-light text-[#D4AF37]">Indian Heritage</span></h1>
                        <p class="text-stone-300 font-medium mb-8 max-w-md">Discover authentic artworks from master artisans across India, commission custom pieces, and join immersive workshops.</p>
                        <div class="flex gap-4">
                            <button onclick="window.location.href='/dashboard-arts'" class="bg-[#B5451B] text-white text-[10px] font-bold uppercase tracking-widest px-6 py-3 rounded hover:bg-[#D4AF37] transition-all shadow-lg">Explore Artworks</button>
                            <button onclick="window.location.href='/dashboard-artists'" class="bg-white/10 text-white border border-white/20 text-[10px] font-bold uppercase tracking-widest px-6 py-3 rounded hover:bg-white hover:text-stone-900 transition-all backdrop-blur">Meet Masters</button>
                        </div>
                    </div>
                </section>

                <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="glass-panel p-6 rounded-2xl flex items-center gap-4 hover:shadow-lg transition-shadow cursor-pointer" onclick="window.location.href='/dashboard-commissions'">
                        <div class="w-14 h-14 rounded-full bg-[#B5451B]/10 flex items-center justify-center">
                            <span class="material-symbols-outlined text-[#B5451B] text-2xl">history_edu</span>
                        </div>
                        <div>
                            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-widest">Active Commissions</p>
                            <p class="text-2xl font-serif font-bold text-stone-900" id="stat-commissions">-</p>
                        </div>
                    </div>
                    <div class="glass-panel p-6 rounded-2xl flex items-center gap-4 hover:shadow-lg transition-shadow cursor-pointer" onclick="window.location.href='/dashboard-workshops'">
                        <div class="w-14 h-14 rounded-full bg-[#D4AF37]/10 flex items-center justify-center">
                            <span class="material-symbols-outlined text-[#D4AF37] text-2xl">event_available</span>
                        </div>
                        <div>
                            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-widest">Upcoming Workshops</p>
                            <p class="text-2xl font-serif font-bold text-stone-900" id="stat-workshops">-</p>
                        </div>
                    </div>
                    <div class="glass-panel p-6 rounded-2xl flex items-center gap-4 hover:shadow-lg transition-shadow cursor-pointer" onclick="window.location.href='/dashboard-arts'">
                        <div class="w-14 h-14 rounded-full bg-stone-100 flex items-center justify-center">
                            <span class="material-symbols-outlined text-stone-600 text-2xl">favorite</span>
                        </div>
                        <div>
                            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-widest">Saved Artworks</p>
                            <p class="text-2xl font-serif font-bold text-stone-900">0</p>
                        </div>
                    </div>
                </section>

                <section class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <div class="glass-panel rounded-3xl p-8 border border-stone-200 flex flex-col h-full">
                        <div class="flex justify-between items-end mb-6">
                            <div>
                                <h3 class="text-2xl font-serif text-[#1A1208] mb-1">Local Heritage Masters</h3>
                                <p class="text-xs font-bold text-stone-400 uppercase tracking-widest flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">location_on</span>
                                    <span id="user-location-text">Detecting location...</span>
                                </p>
                            </div>
                            <a href="/dashboard-artists" class="text-xs font-bold text-[#B5451B] uppercase tracking-widest hover:underline">View All</a>
                        </div>
                        
                        <div id="local-artists-container" class="flex-1 flex flex-col justify-center gap-4">
                            <!-- Loading shimmer -->
                            <div class="animate-pulse flex space-x-4">
                                <div class="rounded-xl bg-stone-200 h-16 w-16"></div>
                                <div class="flex-1 space-y-4 py-1">
                                    <div class="h-2 bg-stone-200 rounded w-3/4"></div>
                                    <div class="h-2 bg-stone-200 rounded w-1/2"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="glass-panel rounded-3xl p-8 border border-stone-200">
                        <div class="flex justify-between items-end mb-6">
                            <h3 class="text-2xl font-serif text-[#1A1208]">Trending Collection</h3>
                            <a href="/dashboard-arts" class="text-xs font-bold text-[#B5451B] uppercase tracking-widest hover:underline">View All</a>
                        </div>
                        <div class="space-y-4" id="trending-artworks">
                            <div class="animate-pulse flex space-x-4">
                                <div class="rounded-xl bg-stone-200 h-20 w-20"></div>
                                <div class="flex-1 space-y-4 py-1">
                                    <div class="h-2 bg-stone-200 rounded w-3/4"></div>
                                    <div class="space-y-3">
                                        <div class="h-2 bg-stone-200 rounded"></div>
                                        <div class="h-2 bg-stone-200 rounded w-5/6"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            // Stats loading
            try {
                const payRes = await fetch('/api/user/payments');
                const payData = await payRes.json();
                if (payData.success) {
                    document.getElementById('stat-commissions').textContent = payData.payments.length;
                }
            } catch(e) {}

            try {
                const workRes = await fetch('/api/workshops');
                const workData = await workRes.json();
                if (workData.success) {
                    document.getElementById('stat-workshops').textContent = workData.workshops.length;
                }
            } catch(e) {}

            // Trending Artworks
            try {
                const trendingContainer = document.getElementById('trending-artworks');
                const artsRes = await fetch('/api/artworks');
                const artsData = await artsRes.json();
                
                if (artsData.success && artsData.artworks && artsData.artworks.length > 0) {
                    const availableArtworks = artsData.artworks.filter(a => a.status === 'Available' || !a.status).slice(0, 3);
                    
                    if (availableArtworks.length > 0) {
                        trendingContainer.innerHTML = availableArtworks.map(art => `
                            <div class="flex items-center gap-4 group cursor-pointer bg-white p-3 rounded-xl border border-transparent hover:border-stone-200 hover:shadow-md transition-all" onclick="window.location.href='/dashboard-arts'">
                                <div class="w-16 h-16 rounded-lg overflow-hidden shrink-0">
                                    <img src="${art.imageUrl || 'pics/madhubani_bg.png'}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h4 class="font-serif font-bold text-lg text-stone-900 truncate group-hover:text-[#B5451B] transition-colors">${art.title}</h4>
                                    <p class="text-[10px] text-stone-500 uppercase tracking-widest">₹${art.price}</p>
                                </div>
                                <div class="text-right shrink-0">
                                    <span class="material-symbols-outlined text-stone-300 group-hover:text-[#B5451B] transition-colors">arrow_forward_ios</span>
                                </div>
                            </div>
                        `).join('');
                    } else {
                        trendingContainer.innerHTML = '<p class="text-stone-500 text-sm">No trending artworks right now.</p>';
                    }
                } else {
                    trendingContainer.innerHTML = '<p class="text-stone-500 text-sm">No trending artworks right now.</p>';
                }
            } catch(e) {
                console.error("Trending fetch error:", e);
                document.getElementById('trending-artworks').innerHTML = '<p class="text-stone-500 text-sm">Failed to load trending artworks.</p>';
            }

            // Location Detection & Local Artists
            try {
                const locText = document.getElementById('user-location-text');
                const locContainer = document.getElementById('local-artists-container');
                
                // Fetch user location
                const locRes = await fetch('https://ipapi.co/json/');
                const locData = await locRes.json();
                
                let state = locData.region || locData.city || 'Tamil Nadu'; // Fallback
                locText.textContent = state + ', ' + locData.country_name;

                // Fetch artists
                const artistsRes = await fetch('/api/artists/approved');
                const artistsData = await artistsRes.json();
                
                if (artistsData.success && artistsData.artists) {
                    const localArtists = artistsData.artists.filter(a => 
                        a.specialization.toLowerCase().includes(state.toLowerCase()) || 
                        (a.bio && a.bio.toLowerCase().includes(state.toLowerCase()))
                    ).slice(0, 3); // Get up to 3 local artists

                    const displayArtists = localArtists.length > 0 ? localArtists : artistsData.artists.slice(0, 3);
                    
                    if (displayArtists.length === 0) {
                        locContainer.innerHTML = `<p class="text-stone-500 text-sm">No artists found in your region.</p>`;
                        return;
                    }

                    locContainer.innerHTML = displayArtists.map(artist => `
                        <div class="flex items-center gap-4 group cursor-pointer bg-white p-3 rounded-xl border border-transparent hover:border-stone-200 hover:shadow-md transition-all" onclick="window.location.href='/artist-profile/${artist._id}'">
                            <div class="w-16 h-16 rounded-full overflow-hidden shrink-0 border-2 border-transparent group-hover:border-[#D4AF37] transition-all">
                                <img src="${artist.profilePic || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + artist.fullName}" class="w-full h-full object-cover">
                            </div>
                            <div class="flex-1 min-w-0">
                                <h4 class="font-serif font-bold text-lg text-stone-900 truncate group-hover:text-[#B5451B] transition-colors">${artist.fullName}</h4>
                                <p class="text-[10px] text-stone-500 uppercase tracking-widest">${artist.specialization}</p>
                            </div>
                            <div class="text-right shrink-0">
                                <span class="material-symbols-outlined text-stone-300 group-hover:text-[#B5451B] transition-colors">east</span>
                            </div>
                        </div>
                    `).join('');
                }
            } catch(e) {
                console.error("Location detection error", e);
                document.getElementById('user-location-text').textContent = "Location unavailable";
                document.getElementById('local-artists-container').innerHTML = `<p class="text-stone-500 text-sm">Could not load local artists.</p>`;
            }
        });
    </script>
</body>
</html>