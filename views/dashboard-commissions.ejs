<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>My Commissions | The Painted Muse</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&family=Outfit:wght@400;500;700&family=Great+Vibes&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="components/DashboardNavbar.js" defer></script>
    <style>
        :root {
            --primary: #B5451B;
            --accent: #D4AF37;
            --background: #FDFBF7;
            --text: #1A1208;
            --cream: #F5F0E8;
            --warm: #FFF8F0;
        }
        .material-symbols-outlined {
            font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24
        }
        body {
            background-color: var(--background);
            color: var(--text);
            font-family: 'Outfit', sans-serif;
        }
        .font-serif { font-family: 'Cormorant Garamond', serif; }
        
        .ink-grain {
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
            opacity: 0.04;
            pointer-events: none;
            position: fixed;
            inset: 0;
            z-index: 99;
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(212, 175, 55, 0.1);
        }

        @keyframes pageFadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        main > div {
            animation: pageFadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(26, 18, 8, 0.05); }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 10px; }
    </style>
</head>
<body class="min-h-[100dvh] flex flex-col bg-gradient-to-br from-[#FDFBF7] via-[#F5F0E8] to-[#E8E4D9] relative">
    <dashboard-navbar type="user"></dashboard-navbar>
    <div class="ink-grain"></div>
        
    <main class="flex-1 w-full overflow-y-auto custom-scrollbar relative">
        <div class="p-6 md:p-10 space-y-10 max-w-7xl mx-auto w-full">
                <div>
                    <h1 class="text-4xl font-serif text-[#1A1208] mb-2">Commission & <span class="italic text-[#D4AF37]">Order History</span></h1>
                    <p class="text-stone-500">Track your active commissions, workshop bookings, and past purchases.</p>
                </div>

                <div class="glass-panel p-8 rounded-3xl border border-stone-200 shadow-sm">
                    <div class="flex justify-between items-center mb-8 border-b border-stone-200 pb-4">
                        <h3 class="text-xl font-serif text-[#1A1208] flex items-center gap-2">
                            <span class="material-symbols-outlined text-[#B5451B]">receipt_long</span> 
                            Recent Transactions
                        </h3>
                        <span id="commissions-count" class="text-[10px] font-bold text-stone-400 uppercase tracking-widest bg-stone-100 px-3 py-1 rounded-full">Loading...</span>
                    </div>
                    
                    <div id="commissions-container" class="space-y-4">
                        <div class="animate-pulse flex space-x-4">
                            <div class="rounded-xl bg-stone-200 h-16 w-16"></div>
                            <div class="flex-1 space-y-4 py-1">
                                <div class="h-2 bg-stone-200 rounded w-1/4"></div>
                                <div class="h-2 bg-stone-200 rounded w-1/2"></div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="h-10"></div>
            </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            try {
                const res = await fetch('/api/user/payments');
                const data = await res.json();
                const container = document.getElementById('commissions-container');
                const countSpan = document.getElementById('commissions-count');
                
                if (data.success && data.payments && data.payments.length > 0) {
                    countSpan.textContent = `${data.payments.length} Transactions`;
                    container.innerHTML = '';
                    data.payments.forEach(payment => {
                        const date = new Date(payment.createdAt).toLocaleDateString('en-IN', {
                            year: 'numeric', month: 'long', day: 'numeric'
                        });
                        
                        const isWorkshop = payment.itemName.toLowerCase().includes('workshop');
                        const icon = isWorkshop ? 'event_available' : 'palette';
                        const bgColor = isWorkshop ? 'bg-orange-100 text-[#B5451B]' : 'bg-[#D4AF37]/20 text-[#D4AF37]';
                        
                        const itemHTML = `
                        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 p-6 bg-white rounded-2xl hover:shadow-lg transition-all border border-stone-100 group">
                            <div class="w-16 h-16 ${bgColor} rounded-xl flex items-center justify-center overflow-hidden shrink-0 group-hover:scale-110 transition-transform">
                                <span class="material-symbols-outlined text-3xl">${icon}</span>
                            </div>
                            <div class="flex-1 w-full">
                                <div class="flex justify-between items-start mb-1">
                                    <h4 class="text-lg font-bold text-stone-900">${payment.itemName.replace('Commission: ', '')}</h4>
                                    <span class="text-lg font-bold text-[#1A1208]">₹${payment.amount.toLocaleString('en-IN')}</span>
                                </div>
                                <div class="flex flex-wrap items-center gap-4 text-xs text-stone-500 mt-2">
                                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">calendar_today</span> ${date}</span>
                                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">tag</span> ${payment.transactionId}</span>
                                    <span class="px-2 py-1 rounded bg-green-50 text-green-700 font-bold uppercase tracking-widest text-[9px] border border-green-100">Paid / ${payment.status || 'Active'}</span>
                                </div>
                            </div>
                        </div>
                        `;
                        container.innerHTML += itemHTML;
                    });
                } else {
                    countSpan.textContent = '0 Transactions';
                    container.innerHTML = `
                        <div class="text-center py-12">
                            <div class="w-20 h-20 bg-stone-50 rounded-full flex items-center justify-center mx-auto mb-4 border border-stone-100">
                                <span class="material-symbols-outlined text-4xl text-stone-300">history</span>
                            </div>
                            <h4 class="text-lg font-serif text-stone-900 mb-2">No Commissions Yet</h4>
                            <p class="text-stone-500 text-sm mb-6 max-w-sm mx-auto">You haven't commissioned any artworks or booked any workshops yet.</p>
                            <button onclick="window.location.href='/dashboard-arts'" class="bg-[#1A1208] text-white text-[10px] font-bold uppercase tracking-widest px-6 py-3 rounded hover:bg-[#B5451B] transition-all">Explore Artworks</button>
                        </div>
                    `;
                }
            } catch (e) {
                console.error('Failed to fetch payments', e);
                document.getElementById('commissions-container').innerHTML = '<p class="text-red-500 text-sm p-4">Failed to load history. Please try again.</p>';
            }
        });
    </script>
</body>
</html>