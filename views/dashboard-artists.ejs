<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Meet the Masters | The Painted Muse</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&family=Outfit:wght@400;500;700&family=Great+Vibes&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="components/DashboardNavbar.js" defer></script>
    <style>
        :root {
            --primary: #B5451B;
            --accent: #D4AF37;
            --background: #FDFBF7;
            --text: #1A1208;
            --cream: #F5F0E8;
            --warm: #FFF8F0;
        }
        .material-symbols-outlined {
            font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24
        }
        body {
            background-color: var(--background);
            color: var(--text);
            font-family: 'Outfit', sans-serif;
        }
        .font-serif { font-family: 'Cormorant Garamond', serif; }
        .font-calligraphy { font-family: 'Great Vibes', cursive; }
        
        .ink-grain {
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
            opacity: 0.04;
            pointer-events: none;
            position: fixed;
            inset: 0;
            z-index: 99;
        }

        .warli-border {
            border: 1px solid rgba(212, 175, 55, 0.2);
            position: relative;
        }
        .warli-border::before {
            content: "";
            position: absolute;
            inset: 4px;
            border: 1px solid rgba(212, 175, 55, 0.1);
            pointer-events: none;
        }

        @keyframes pageFadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        main > div {
            animation: pageFadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(26, 18, 8, 0.05); }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 10px; }
        .shimmer {
            background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.1), transparent);
            background-size: 200% 100%;
            animation: shimmer 2s infinite;
        }
        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }
    </style>
</head>
<body class="min-h-[100dvh] flex flex-col bg-gradient-to-br from-[#FDFBF7] via-[#F5F0E8] to-[#E8E4D9] relative">
    <dashboard-navbar type="user"></dashboard-navbar>
    <div class="ink-grain"></div>
        
    <main class="flex-1 w-full overflow-y-auto custom-scrollbar relative">
        <div class="p-6 md:p-10 space-y-10 max-w-7xl mx-auto w-full">
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                    <div>
                        <h1 class="text-4xl font-serif text-[#1A1208] mb-2">Heritage <span class="italic text-[#D4AF37]">Artisans</span></h1>
                        <p class="text-stone-500 max-w-xl">Discover master artisans preserving centuries-old traditions. Support their legacy by commissioning authentic pieces directly.</p>
                    </div>
                    <div class="flex gap-4">
                        <div class="relative w-full md:w-64">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 text-sm">search</span>
                            <input type="text" id="artist-search" onkeyup="filterArtists()" placeholder="Search by name or region..." class="w-full pl-10 pr-4 py-2.5 bg-white border border-stone-200 shadow-sm rounded-lg text-sm focus:ring-1 focus:ring-[#D4AF37] transition-all">
                        </div>
                        <select id="region-filter" onchange="filterArtists()" class="bg-white border border-stone-200 text-stone-600 text-sm rounded-lg shadow-sm focus:ring-[#D4AF37] focus:border-[#D4AF37] block p-2.5">
                            <option value="">All Regions</option>
                            <option value="Bihar">Bihar</option>
                            <option value="Tamil Nadu">Tamil Nadu</option>
                            <option value="Maharashtra">Maharashtra</option>
                            <option value="Odisha">Odisha</option>
                        </select>
                    </div>
                </div>

                <div id="artists-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
                    <!-- Shimmer placeholders -->
                    <div class="warli-border h-80 rounded-xl overflow-hidden bg-stone-50 shimmer"></div>
                    <div class="warli-border h-80 rounded-xl overflow-hidden bg-stone-50 shimmer"></div>
                    <div class="warli-border h-80 rounded-xl overflow-hidden bg-stone-50 shimmer"></div>
                    <div class="warli-border h-80 rounded-xl overflow-hidden bg-stone-50 shimmer"></div>
                </div>
                
                <div class="h-10"></div>
            </div>
        </div>
    </main>

    <script>
        let allArtists = [];

        async function fetchArtists() {
            try {
                const res = await fetch('/api/artists/approved');
                const data = await res.json();
                if (data.success) {
                    allArtists = data.artists;
                    renderArtists(allArtists);
                }
            } catch(e) {
                console.error("Error fetching artists", e);
                document.getElementById('artists-grid').innerHTML = '<p class="col-span-full text-center text-stone-500 py-10">Failed to load artists. Please try again later.</p>';
            }
        }

        function renderArtists(artists) {
            const grid = document.getElementById('artists-grid');
            grid.innerHTML = '';
            
            if(artists.length === 0) {
                grid.innerHTML = '<p class="col-span-full text-center text-stone-500 py-10">No artists found matching your criteria.</p>';
                return;
            }

            artists.forEach((artist, index) => {
                const img = artist.profilePic || "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&q=80&w=400";
                const rating = 4.8;
                const card = `
                    <div class="warli-border group artist-card rounded-xl overflow-hidden bg-white shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 opacity-0 animate-fade-in flex flex-col" style="animation: pageFadeIn 0.5s ease-out forwards; animation-delay: ${index * 50}ms;">
                        <div class="h-56 overflow-hidden relative">
                            <img src="${img}" alt="${artist.fullName}" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                        </div>
                        <div class="p-6 flex-1 flex flex-col">
                            <div class="flex justify-between items-start mb-2">
                                <h4 class="text-xl font-serif text-[#1A1208] leading-tight truncate">${artist.fullName}</h4>
                                <div class="flex items-center gap-1 text-[#D4AF37]">
                                    <span class="material-symbols-outlined text-sm">star</span>
                                    <span class="text-xs font-bold">${rating}</span>
                                </div>
                            </div>
                            <p class="text-[10px] text-[#B5451B] uppercase tracking-widest font-bold mb-1">${artist.specialization || 'Heritage'} Master</p>
                            <p class="text-xs text-stone-500 mb-4 flex items-center gap-1"><span class="material-symbols-outlined text-sm">location_on</span> ${artist.location || 'India'}</p>
                            
                            <div class="mt-auto">
                                <button onclick="window.location.href='/artist-profile/${artist._id}'" class="w-full py-3 bg-stone-100 text-[#1A1208] border border-stone-200 text-[10px] font-bold uppercase tracking-widest rounded hover:bg-[#B5451B] hover:text-white hover:border-[#B5451B] transition-all flex items-center justify-center gap-2">
                                    View Portfolio <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                grid.innerHTML += card;
            });
        }

        function filterArtists() {
            const query = document.getElementById('artist-search').value.toLowerCase();
            const region = document.getElementById('region-filter').value.toLowerCase();
            
            const filtered = allArtists.filter(a => {
                const matchesQuery = a.fullName.toLowerCase().includes(query) || (a.specialization && a.specialization.toLowerCase().includes(query));
                const matchesRegion = region === '' || (a.location && a.location.toLowerCase().includes(region));
                return matchesQuery && matchesRegion;
            });
            
            renderArtists(filtered);
        }

        document.addEventListener('DOMContentLoaded', fetchArtists);
    </script>
</body>
</html>