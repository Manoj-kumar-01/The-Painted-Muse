<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Messages | The Painted Muse</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&family=Outfit:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="/components/DashboardNavbar.js" type="module"></script>
    <style>
        body {
            font-family: 'Outfit', sans-serif;
        }
        .serif {
            font-family: 'Cormorant Garamond', serif;
        }
    </style>
</head>
<body class="selection:bg-[#D4AF37]/30 bg-gradient-to-br from-[#FDFBF7] via-[#F5F0E8] to-[#E8E4D9] min-h-[100dvh] flex flex-col relative overflow-y-auto">

    <dashboard-navbar type="user"></dashboard-navbar>

    <main class="flex-1 max-w-5xl w-full mx-auto px-6 lg:px-10 py-12 relative z-10">
        
        <div class="flex items-center justify-between mb-8">
            <div>
                <h2 class="text-3xl font-serif text-[#1A1208] mb-2 flex items-center gap-3">
                    <span class="material-symbols-outlined text-[#B5451B]">forum</span> Secure Inbox
                </h2>
                <p class="text-stone-500 text-sm flex items-center gap-2">
                    <span class="material-symbols-outlined text-[14px] text-green-600">lock</span> End-to-end encrypted messaging
                </p>
            </div>
            <div class="bg-white px-4 py-2 rounded-full border border-stone-200 text-xs font-bold text-stone-500 shadow-sm flex items-center gap-2">
                <span id="unread-count" class="w-5 h-5 bg-[#B5451B] text-white rounded-full flex items-center justify-center text-[10px]">0</span> Unread
            </div>
        </div>

        <div class="bg-white rounded-3xl border border-stone-200 overflow-hidden shadow-xl" style="min-height: 60vh;">
            <div id="inbox-container" class="divide-y divide-stone-100 flex flex-col h-full">
                <!-- Loading State -->
                <div class="p-12 text-center text-stone-400">
                    <span class="material-symbols-outlined text-4xl animate-spin mb-4">refresh</span>
                    <p>Loading messages...</p>
                </div>
            </div>
        </div>

    </main>

    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            try {
                const res = await fetch('/api/chat/inbox');
                const data = await res.json();
                const container = document.getElementById('inbox-container');
                const unreadBadge = document.getElementById('unread-count');
                
                if (data.success && data.conversations) {
                    container.innerHTML = '';
                    let totalUnread = 0;

                    if (data.conversations.length === 0) {
                        container.innerHTML = `
                            <div class="flex-1 flex flex-col items-center justify-center p-16 text-center">
                                <div class="w-24 h-24 bg-stone-50 rounded-full flex items-center justify-center mb-6 border border-stone-100 shadow-inner">
                                    <span class="material-symbols-outlined text-5xl text-stone-300">drafts</span>
                                </div>
                                <h3 class="text-2xl font-serif text-[#1A1208] mb-2">No Messages Yet</h3>
                                <p class="text-stone-500 text-sm max-w-md mx-auto mb-8">Reach out to artists to commission artwork, or discuss ongoing workshops.</p>
                                <button onclick="window.location.href='/dashboard-artists'" class="bg-[#1A1208] text-white text-[10px] font-bold uppercase tracking-widest px-8 py-4 rounded hover:bg-[#B5451B] transition-all shadow-md">Find Artists</button>
                            </div>
                        `;
                    }

                    data.conversations.forEach(convo => {
                        totalUnread += convo.unreadCount;
                        const dateStr = new Date(convo.lastMessageTime).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                        const timeStr = new Date(convo.lastMessageTime).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });

                        const unreadHtml = convo.unreadCount > 0 
                            ? `<span class="bg-[#B5451B] text-white text-[10px] font-bold px-2 py-0.5 rounded-full">${convo.unreadCount}</span>` 
                            : '';

                        const unreadBg = convo.unreadCount > 0 ? 'bg-[#FDFBF7]' : 'bg-white';
                        const linkParam = convo.otherModel === 'Artist' ? `artistId=${convo.otherId}&artist=${encodeURIComponent(convo.partnerName)}` : `userId=${convo.otherId}`;

                        const html = `
                            <a href="/chat?${linkParam}" class="flex items-center gap-5 p-6 hover:bg-stone-50 transition-colors ${unreadBg} cursor-pointer group">
                                <div class="w-14 h-14 rounded-full overflow-hidden border border-stone-200 shrink-0 shadow-sm relative">
                                    <img src="${convo.partnerPic}" class="w-full h-full object-cover">
                                    ${convo.unreadCount > 0 ? '<div class="absolute top-0 right-0 w-3 h-3 bg-[#B5451B] border-2 border-white rounded-full shadow-sm"></div>' : ''}
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between mb-1">
                                        <h4 class="text-base font-bold text-[#1A1208] truncate group-hover:text-[#B5451B] transition-colors">${convo.partnerName}</h4>
                                        <span class="text-[11px] text-stone-400 font-medium whitespace-nowrap ml-4">${dateStr} ${timeStr}</span>
                                    </div>
                                    <p class="text-sm ${convo.unreadCount > 0 ? 'text-[#1A1208] font-bold' : 'text-stone-500'} truncate">${convo.lastMessage}</p>
                                    <p class="text-[10px] text-stone-400 uppercase tracking-widest mt-1.5 flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[10px]">person</span> ${convo.partnerSubtitle}
                                    </p>
                                </div>
                                <div class="pl-4 shrink-0 flex flex-col items-end gap-3">
                                    ${unreadHtml}
                                    <span class="material-symbols-outlined text-stone-300 group-hover:text-[#D4AF37] transition-colors group-hover:translate-x-1">arrow_forward</span>
                                </div>
                            </a>
                        `;
                        container.innerHTML += html;
                    });

                    unreadBadge.textContent = totalUnread;
                } else {
                    container.innerHTML = '<div class="p-12 text-center text-red-500">Failed to load messages.</div>';
                }
            } catch(e) {
                console.error(e);
                document.getElementById('inbox-container').innerHTML = '<div class="p-12 text-center text-red-500">Failed to load messages.</div>';
            }
        });
    </script>
</body>
</html>
