<!DOCTYPE html>
<html class="light" lang="en">
<head>
<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />
<title>Secure Checkout | The Painted Muse</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&family=Outfit:wght@400;500;700&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
<style>
body {
  background-color: #FDFBF7;
  min-height: 100vh;
  font-family: 'Inter', sans-serif;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
}
.premium-card {
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.08);
}
.input-focus:focus {
  box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
  border-color: #4F46E5;
}
.shiny-gradient-btn {
  background: linear-gradient(135deg, #8b3414 0%, #B5451B 50%, #D4AF37 100%);
  position: relative;
  overflow: hidden;
}
.shimmer::after {
  content: "";
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(to bottom right,
  rgba(255, 255, 255, 0) 0%,
  rgba(255, 255, 255, 0) 40%,
  rgba(255, 255, 255, 0.4) 50%,
  rgba(255, 255, 255, 0) 60%,
  rgba(255, 255, 255, 0) 100%);
  transform: rotate(45deg);
  animation: shimmer 3s infinite;
}
@keyframes shimmer {
  0% { transform: translateX(-100%) rotate(45deg); }
  100% { transform: translateX(100%) rotate(45deg); }
}
.upi-id-box {
  background: #F1F5F9;
  color: #1E293B;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
}
</style>
</head>
<body class="text-[#1A1208] antialiased">

<!-- Floating Back Button -->
<button onclick="history.back()" class="absolute top-6 left-6 md:top-8 md:left-8 flex items-center gap-2 text-[#1A1208]/60 hover:text-[#1A1208] transition-colors bg-white px-4 py-2 rounded-full shadow-sm border border-[#D4AF37]/20">
  <span class="material-symbols-outlined text-lg">arrow_back</span>
  <span class="font-medium text-sm">Back</span>
</button>

<main class="w-full max-w-4xl premium-card rounded-3xl overflow-hidden flex flex-col md:flex-row">
  
  <!-- Left Side: Order Summary -->
  <aside class="w-full md:w-5/12 bg-[#F5F0E8] p-8 border-b md:border-b-0 md:border-r border-[#D4AF37]/20 flex flex-col justify-between">
    <div>
      <div class="mb-8">
        <h2 class="text-sm font-bold text-[#B5451B] tracking-widest uppercase mb-1">Secure Checkout</h2>
        <h1 class="text-2xl font-bold text-[#1A1208]">Order Summary</h1>
      </div>

      <div class="flex items-center gap-4 mb-8">
        <div class="w-16 h-16 rounded-xl overflow-hidden border border-[#D4AF37]/20 bg-white flex-shrink-0">
          <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&q=80&w=200" class="w-full h-full object-cover opacity-80" alt="Item preview" />
        </div>
        <div>
          <h3 id="pg-item-name" class="font-bold text-[#1A1208] leading-tight">Art Commission</h3>
          <p id="pg-item-tier" class="text-xs font-medium text-[#1A1208]/60 mt-1">One-time Purchase</p>
        </div>
      </div>

      <div class="space-y-4 text-sm font-medium">
        <div class="flex justify-between text-[#1A1208]/80">
          <span>Subtotal</span>
          <span id="pg-subtotal">₹0.00</span>
        </div>
        <div class="flex justify-between text-[#1A1208]/80">
          <span>Platform Fee</span>
          <span id="pg-platform-fee">₹12.50</span>
        </div>
        <div class="flex justify-between text-[#1A1208]/80">
          <span>Secured Tax</span>
          <span id="pg-tax">₹0.00</span>
        </div>
      </div>
    </div>

    <div class="pt-6 border-t border-[#D4AF37]/20 mt-8">
      <div class="flex justify-between items-end mb-4">
        <span class="text-sm font-bold text-[#1A1208]/60 uppercase tracking-widest">Total</span>
        <span id="pg-total" class="text-3xl font-bold text-[#B5451B]">₹0.00</span>
      </div>
      <div class="flex items-center gap-2 text-xs font-semibold text-green-700 bg-green-100/50 p-3 rounded-xl">
        <span class="material-symbols-outlined text-[16px]">verified</span>
        100% Secure E2E Payment
      </div>
    </div>
  </aside>

  <!-- Right Side: Payment Details -->
  <section class="w-full md:w-7/12 p-8" id="payment-form-section">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-xl bg-[#B5451B]/10 flex items-center justify-center">
        <span class="material-symbols-outlined text-[#B5451B]">qr_code_2</span>
      </div>
      <div>
        <h2 class="text-lg font-bold text-[#1A1208]">Pay via UPI</h2>
        <p class="text-xs font-medium text-[#1A1208]/60">Scan QR or use manual ID</p>
      </div>
    </div>

    <div class="flex flex-col items-center justify-center mb-6">
      <div class="bg-white p-3 rounded-2xl shadow-md border border-[#D4AF37]/10 transform transition-transform hover:scale-105">
        <img id="upi-qr-img" alt="UPI QR Code" class="w-48 h-48 object-contain" src="" />
      </div>
      <div class="flex gap-2 mt-4">
        <span class="px-3 py-1 bg-[#F5F0E8] rounded-full text-[10px] font-bold text-[#1A1208]/80 tracking-widest uppercase">GPay</span>
        <span class="px-3 py-1 bg-[#F5F0E8] rounded-full text-[10px] font-bold text-[#1A1208]/80 tracking-widest uppercase">PhonePe</span>
        <span class="px-3 py-1 bg-[#F5F0E8] rounded-full text-[10px] font-bold text-[#1A1208]/80 tracking-widest uppercase">Paytm</span>
      </div>
    </div>

    <div class="mb-8">
      <label class="block text-xs font-bold text-[#1A1208]/60 uppercase tracking-widest mb-2">UPI ID</label>
      <div class="upi-id-box rounded-xl p-3 flex items-center justify-between border border-[#D4AF37]/20">
        <span class="font-bold tracking-wide text-[#1A1208] text-sm" id="upi-id-text">paintedmuse@upi</span>
        <button id="copy-upi-btn" onclick="copyUPI()" class="flex items-center gap-1 text-[#B5451B] font-bold bg-white px-3 py-1.5 rounded-lg border border-[#B5451B]/20 hover:bg-[#B5451B]/10 transition-colors text-xs">
          <span class="material-symbols-outlined text-[14px]">content_copy</span>
          <span id="copy-btn-text">Copy</span>
        </button>
      </div>
    </div>

    <form id="upi-confirmation-form" onsubmit="handleUpiSubmit(event)" class="space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-[#1A1208]/60 uppercase tracking-widest mb-1">Sender Name</label>
          <input id="user-name" type="text" placeholder="Bank Acc Name" required class="w-full bg-[#F5F0E8] border border-[#D4AF37]/20 rounded-xl p-3 text-sm focus:outline-none input-focus transition-all" />
        </div>
        <div>
          <label class="block text-xs font-bold text-[#1A1208]/60 uppercase tracking-widest mb-1">UTR (12 Digits)</label>
          <input id="transaction-id" type="text" placeholder="e.g. 123456789012" required class="w-full bg-[#F5F0E8] border border-[#D4AF37]/20 rounded-xl p-3 text-sm focus:outline-none input-focus transition-all" />
        </div>
      </div>
      
      <div class="flex items-start gap-3 py-2">
        <input id="payment-confirm" type="checkbox" required class="mt-1 w-4 h-4 rounded border-stone-300 text-[#B5451B] focus:ring-[#B5451B] cursor-pointer" />
        <label for="payment-confirm" class="text-xs text-[#1A1208]/80 font-medium cursor-pointer" id="pg-confirm-label">
          I confirm I have transferred the exact amount to paintedmuse@upi
        </label>
      </div>

      <button type="submit" class="w-full shiny-gradient-btn shimmer text-white font-bold py-4 rounded-xl shadow-lg hover:shadow-[#B5451B]/30 transition-all flex items-center justify-center gap-2 active:scale-[0.98] group mt-2">
        Confirm Payment
        <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
      </button>
    </form>
  </section>
</main>

<script>
// Payment Logic
var UPI_ID = 'paintedmuse@upi';
var UPI_NAME = 'ThePaintedMuse';
var PLATFORM_FEE = 12.50;
var TAX_RATE = 0.08;

function formatINR(num) {
  return '₹' + num.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function buildQrUrl(amount) {
  var upiString = 'upi://pay?pa=' + UPI_ID + '&pn=' + UPI_NAME + '&am=' + amount.toFixed(2) + '&cu=INR&tn=ArtPurchase';
  return 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=' + encodeURIComponent(upiString) + '&bgcolor=ffffff&color=0f172a&qzone=2';
}

document.getElementById('upi-qr-img').onerror = function() {
  var currentTotal = parseFloat(this.dataset.amount) || 0;
  this.src = 'https://chart.googleapis.com/chart?chs=300x300&cht=qr&chl=' +
    encodeURIComponent('upi://pay?pa=' + UPI_ID + '&pn=' + UPI_NAME + '&am=' + currentTotal.toFixed(2) + '&cu=INR') +
    '&choe=UTF-8';
};

(function() {
  var urlParams = new URLSearchParams(window.location.search);
  var item = urlParams.get('item');
  var price = urlParams.get('price');

  if (item && price) {
    var subtotal = parseFloat(price);
    if (isNaN(subtotal) || subtotal <= 0) return;

    var tax = subtotal * TAX_RATE;
    var total = subtotal + PLATFORM_FEE + tax;

    document.getElementById('pg-item-name').textContent = item;
    
    document.getElementById('pg-subtotal').textContent = formatINR(subtotal);
    document.getElementById('pg-platform-fee').textContent = formatINR(PLATFORM_FEE);
    document.getElementById('pg-tax').textContent = formatINR(tax);
    document.getElementById('pg-total').textContent = formatINR(total);

    var qrImg = document.getElementById('upi-qr-img');
    qrImg.dataset.amount = total.toFixed(2);
    qrImg.src = buildQrUrl(total);

    document.getElementById('pg-confirm-label').innerHTML =
      'I confirm I have transferred exactly <strong class="text-[#1A1208]">' + formatINR(total) + '</strong> to <strong class="text-[#1A1208]">' + UPI_ID + '</strong>';
  } else {
      // Default dummy data if no params
      document.getElementById('upi-qr-img').src = buildQrUrl(5000);
  }
})();

function copyUPI() {
  navigator.clipboard.writeText(UPI_ID).then(function() {
    var btnText = document.getElementById('copy-btn-text');
    var btn = document.getElementById('copy-upi-btn');
    btnText.innerText = "Copied ✓";
    btn.classList.add('bg-green-600', 'text-white', 'border-green-600');
    btn.classList.remove('bg-white', 'text-[#B5451B]', 'border-[#B5451B]/20');
    setTimeout(function() {
      btnText.innerText = "Copy";
      btn.classList.remove('bg-green-600', 'text-white', 'border-green-600');
      btn.classList.add('bg-white', 'text-[#B5451B]', 'border-[#B5451B]/20');
    }, 2000);
  });
}

function handleUpiSubmit(e) {
  e.preventDefault();
  var name = document.getElementById('user-name').value;
  var utr = document.getElementById('transaction-id').value;
  if (!name || !utr) return;

  var totalText = document.getElementById('pg-total').textContent;
  var itemName = document.getElementById('pg-item-name').textContent || 'Art Purchase';
  var amountNum = parseFloat(totalText.replace(/[^0-9.]/g, ''));
  var bookingRef = "TPM-" + Math.floor(100000 + Math.random() * 900000);
  
  var submitBtn = e.target.querySelector('button[type="submit"]');
  var originalText = submitBtn.innerHTML;
  submitBtn.innerHTML = 'Processing...';
  submitBtn.disabled = true;

  fetch('/api/payments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
          transactionId: utr,
          customerName: name,
          amount: amountNum,
          itemName: itemName,
          bookingReference: bookingRef
      })
  }).then(function(r) { return r.json(); }).then(function(data) {
      if (data.success) {
          var paymentSection = document.getElementById('payment-form-section');
          paymentSection.innerHTML = '<div class="flex flex-col items-center justify-center py-12 text-center h-full">' +
            '<div class="w-20 h-20 rounded-full bg-green-50 flex items-center justify-center mb-6 border border-green-200">' +
            '<span class="material-symbols-outlined text-green-600 text-5xl">check_circle</span>' +
            '</div>' +
            '<h2 class="text-xl font-bold text-[#1A1208] mb-2">Payment Details Submitted</h2>' +
            '<p class="text-sm font-medium text-[#1A1208]/60 max-w-sm mx-auto">' +
            'Thank you, <strong>' + name + '</strong>. Your transaction has been captured for verification.' +
            '</p>' +
            '<div class="mt-8 p-6 bg-[#F5F0E8] rounded-2xl border border-[#D4AF37]/20 w-full">' +
            '<p class="text-xs text-[#1A1208]/60 uppercase tracking-widest mb-1 font-bold">Booking Reference</p>' +
            '<p class="text-xl tracking-widest text-[#B5451B] font-bold">' + bookingRef + '</p>' +
            '</div>' +
            '<button onclick="window.location.href=\'/\'" class="mt-8 text-[#B5451B] font-bold hover:underline text-sm">Return to Home</button>' +
            '</div>';
      } else {
          alert(data.message || 'Error submitting payment.');
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
      }
  }).catch(function(err) {
      console.error(err);
      alert('Network error submitting payment.');
      submitBtn.innerHTML = originalText;
      submitBtn.disabled = false;
  });
}
</script>
</body>
</html>