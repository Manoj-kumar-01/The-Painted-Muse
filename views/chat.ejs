<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />
<title>Secure Artist Chat | The Painted Muse</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&family=Outfit:wght@400;500;700&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
<style>
:root {
  --ink: #1A1208;
  --bg: #FDFBF7;
  --terracotta: #B5451B;
  --saffron: #D4AF37;
}
body {
  background-color: var(--bg);
  color: var(--ink);
  font-family: 'Outfit', sans-serif;
  height: 100vh;
  overflow: hidden;
  margin: 0;
  display: flex;
  justify-content: center;
}
.serif {
  font-family: 'Cormorant Garamond', serif;
}
.chat-container {
  width: 100%;
  max-width: 900px;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: white;
  box-shadow: 0 0 40px rgba(0,0,0,0.05);
}
.message-bubble-artist {
  background: #FDFBF7;
  border: 1px solid rgba(26, 18, 8, 0.1);
  border-bottom-left-radius: 4px;
}
.message-bubble-user {
  background: var(--ink);
  color: #ffffff;
  border-bottom-right-radius: 4px;
}
/* Scrollbar */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(26, 18, 8, 0.15); border-radius: 10px; }
</style>
</head>
<body>

<div class="chat-container relative">
  <!-- Chat Header -->
  <header class="px-6 py-4 border-b border-[rgba(26,18,8,0.1)] bg-white flex justify-between items-center z-10 sticky top-0 shadow-sm">
    <div class="flex items-center gap-4">
      <button onclick="history.back()" class="w-10 h-10 rounded-full hover:bg-stone-100 flex items-center justify-center transition-colors text-stone-500">
        <span class="material-symbols-outlined">arrow_back</span>
      </button>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full overflow-hidden border border-stone-200">
          <img id="partner-pic" src="https://api.dicebear.com/7.x/avataaars/svg?seed=loading" alt="Avatar" class="w-full h-full object-cover">
        </div>
        <div>
          <h3 id="partner-name" class="font-bold text-base flex items-center gap-2">
            Loading...
          </h3>
          <p id="partner-status" class="text-xs text-stone-400 font-medium flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-stone-300"></span> Offline
          </p>
        </div>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <div class="flex items-center gap-1 text-green-600 bg-green-50 px-2 py-1 rounded text-[9px] font-bold uppercase tracking-wider border border-green-200">
        <span class="material-symbols-outlined text-[12px]">lock</span> E2E
      </div>
    </div>
  </header>

  <div id="messages-container" class="flex-grow p-6 overflow-y-auto flex flex-col gap-6 relative" style="background-image: url('data:image/svg+xml;base64,');">
    <!-- Messages and dates will be injected here dynamically -->
  </div>

  <!-- Chat Input Footer -->
  <footer class="p-4 bg-white border-t border-[rgba(26,18,8,0.1)] z-10 flex items-end gap-3 shadow-[0_-4px_20px_rgba(0,0,0,0.02)]">
    <button class="w-10 h-10 rounded-full hover:bg-stone-100 flex items-center justify-center text-stone-400 hover:text-[#B5451B] transition-colors flex-shrink-0">
      <span class="material-symbols-outlined">attach_file</span>
    </button>
    <div class="flex-grow bg-[#FDFBF7] border border-stone-200 rounded-2xl flex items-center">
      <textarea id="chat-input" rows="1" class="w-full bg-transparent border-none focus:ring-0 resize-none text-sm p-3 max-h-32" placeholder="Message..."></textarea>
    </div>
    <button id="send-btn" class="w-11 h-11 bg-[#B5451B] text-white rounded-full hover:bg-[#1A1208] transition-colors shadow-md flex-shrink-0 flex items-center justify-center group">
      <span class="material-symbols-outlined text-[18px] transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">send</span>
    </button>
  </footer>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
const myId = "<%= user ? (user._id || user.id) : '' %>";
if (!myId) {
    window.location.href = '/signin';
}

const urlParams = new URLSearchParams(window.location.search);
const receiverId = urlParams.get('artistId') || urlParams.get('userId');

document.addEventListener('DOMContentLoaded', async () => {
  if (receiverId) {
    try {
      const res = await fetch('/api/chat/partner/' + receiverId);
      const data = await res.json();
      if (data.success) {
        document.getElementById('partner-name').textContent = data.partner.fullName;
        document.getElementById('partner-pic').src = data.partner.profilePic;
        updateStatusUI(data.partner.isOnline);
      } else {
        document.getElementById('partner-name').textContent = "Unknown User";
      }
    } catch(e) {
      document.getElementById('partner-name').textContent = "Unknown User";
    }
  }
});

function updateStatusUI(isOnline) {
  const statusEl = document.getElementById('partner-status');
  if (isOnline) {
    statusEl.className = "text-xs text-green-600 font-medium flex items-center gap-1";
    statusEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span> Online`;
  } else {
    statusEl.className = "text-xs text-stone-400 font-medium flex items-center gap-1";
    statusEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-stone-300"></span> Offline`;
  }
}

// Auto-expand textarea
const tx = document.getElementById('chat-input');
tx.addEventListener('input', function() {
  this.style.height = 'auto';
  this.style.height = (this.scrollHeight) + 'px';
});

// Mock sending message
document.getElementById('send-btn').addEventListener('click', sendMessage);
tx.addEventListener('keypress', function(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendMessage();
  }
});

// Dynamic Chat Integration
const socket = io();

socket.on('newMessage', (msg) => {
  renderMessage(msg);
  if (msg.senderId === receiverId) {
    fetch('/api/chat/mark-read/' + receiverId, { method: 'POST' });
  }
});

socket.on('userStatus', (data) => {
  if (data.userId === receiverId) {
    updateStatusUI(data.online);
  }
});

let lastDateGroup = null;

function formatDateGroup(dateStr) {
    if (!dateStr) return 'Today';
    const msgDate = new Date(dateStr);
    const today = new Date();
    const yesterday = new Date(today);
    yesterday.setDate(yesterday.getDate() - 1);

    if (msgDate.toDateString() === today.toDateString()) {
        return 'Today';
    } else if (msgDate.toDateString() === yesterday.toDateString()) {
        return 'Yesterday';
    } else {
        return msgDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
    }
}

function formatTime(dateStr) {
    if (!dateStr) {
        return new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
    }
    return new Date(dateStr).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
}

function renderMessage(msg) {
  const isMe = msg.senderId === myId;
  const container = document.getElementById('messages-container');
  
  const msgDateGroup = formatDateGroup(msg.createdAt);
  if (msgDateGroup !== lastDateGroup) {
      container.insertAdjacentHTML('beforeend', `
        <div class="text-center my-4">
          <span class="text-[10px] font-bold text-stone-400 uppercase tracking-widest bg-white border border-stone-100 px-3 py-1 rounded-full shadow-sm">${msgDateGroup}</span>
        </div>
      `);
      lastDateGroup = msgDateGroup;
  }
  
  const alignmentClass = isMe ? 'justify-end' : 'justify-start';
  const bubbleClass = isMe ? 'message-bubble-user' : 'message-bubble-artist';
  const timeStr = formatTime(msg.createdAt);
  
  const msgHTML = `
    <div class="flex ${alignmentClass} animate-fade-in mb-2 w-full">
      <div class="${bubbleClass} max-w-[80%] md:max-w-md p-3.5 rounded-2xl shadow-sm text-[15px]">
        <p class="leading-relaxed">${msg.content.replace(/\n/g, '<br>')}</p>
        <div class="text-[9px] text-right mt-1 opacity-60">
          ${timeStr}
        </div>
      </div>
    </div>
  `;
  
  container.insertAdjacentHTML('beforeend', msgHTML);
  container.scrollTop = container.scrollHeight;
}

if(receiverId) {
  fetch('/api/chat/' + receiverId)
    .then(res => res.json())
    .then(data => {
      const container = document.getElementById('messages-container');
      container.innerHTML = `
        <!-- Automated System Message -->
        <div class="flex justify-center mt-6">
          <div class="bg-[#FDFBF7] border border-[#D4AF37]/30 text-[#B5451B] text-[11px] px-4 py-2.5 rounded-xl flex items-center gap-2 max-w-sm text-center shadow-sm">
            <span class="material-symbols-outlined text-sm">shield</span>
            Never share your bank or card details in the chat.
          </div>
        </div>
      `;
      lastDateGroup = null; // Reset for history
      if(data.success && data.messages.length > 0) {
         data.messages.forEach(renderMessage);
      }
      
      // Mark as read when opening chat
      fetch('/api/chat/mark-read/' + receiverId, { method: 'POST' });
    });
}

function sendMessage() {
  const text = tx.value.trim();
  if (!text || !receiverId) {
    if (!receiverId) alert('No chat partner specified. Please select a user or artist to chat with.');
    return;
  }
  
  socket.emit('sendMessage', {
    receiverId: receiverId,
    content: text
  });
  
  tx.value = '';
  tx.style.height = 'auto';
}
</script>
</body>
</html>
