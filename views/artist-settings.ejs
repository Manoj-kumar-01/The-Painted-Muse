<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Studio Settings | The Painted Muse</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Outfit:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="components/DashboardNavbar.js" defer></script>
    <script>
        tailwind.config = { darkMode: "class", theme: { extend: { colors: { "on-background": "#241915", outline: "#8b7169", "outline-variant": "#dfc0b6", "surface-bright": "#fff8f6", surface: "#fff8f6", "surface-container-low": "#fff1ed", primary: "#942e02", background: "#fff8f6", "on-surface": "#241915", "surface-container": "#ffe9e3", "on-primary": "#ffffff", secondary: "#795900", "primary-container": "#b5451b", "surface-variant": "#f4ded7", "on-primary-container": "#ffe4dc", "surface-container-highest": "#f4ded7", "surface-container-lowest": "#ffffff" }, fontFamily: { "label-sm": ["Outfit"], "headline-lg": ["Cormorant Garamond"], "headline-md": ["Cormorant Garamond"], "body-lg": ["Outfit"], "body-md": ["Outfit"] } } } }
    </script>
    <style>
        body { background: #fff8f6; color: #241915; font-family: 'Outfit', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24 }
        .paper-grain { background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E"); opacity: .03; pointer-events: none; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #dfc0b6; border-radius: 10px; }
    </style>
</head>
<body class="bg-surface min-h-[100dvh] flex flex-col bg-gradient-to-br from-[#FDFBF7] via-[#F5F0E8] to-[#E8E4D9] relative">
    <dashboard-navbar type="artist"></dashboard-navbar>
    <div class="ink-grain"></div>

    <main class="flex-1 w-full overflow-y-auto custom-scrollbar relative">
        <div class="p-6 md:p-10 space-y-10 max-w-7xl mx-auto w-full">
                <header class="mb-10">
                    <h1 class="font-headline-lg text-on-background text-4xl mb-2 font-bold">Account Settings</h1>
                    <p class="font-body-lg text-on-surface-variant">Manage your personal information, security, and payouts.</p>
                </header>

                <div class="bg-surface-container-lowest border border-outline-variant rounded-3xl p-8 shadow-sm mb-8">
                    <h3 class="font-headline-md text-2xl font-bold mb-6 text-on-surface flex items-center gap-2 border-b border-outline-variant pb-4">
                        <span class="material-symbols-outlined text-primary">person</span> Profile Information
                    </h3>
                    
                    <div class="flex flex-col md:flex-row gap-8 items-start mb-8">
                        <div class="w-32 h-32 rounded-2xl overflow-hidden border-2 border-outline-variant relative group cursor-pointer" onclick="document.getElementById('profilePicInput').click()">
                            <img id="profile-preview" src="pics/user_profile.png" onerror="this.src='https://api.dicebear.com/7.x/avataaars/svg?seed=Artist'" class="w-full h-full object-cover">
                            <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                <span class="material-symbols-outlined text-white text-3xl">photo_camera</span>
                            </div>
                            <input type="file" id="profilePicInput" accept="image/*" class="hidden" onchange="previewProfilePic(event)">
                        </div>
                        <div class="flex-1 space-y-2">
                            <h4 class="font-bold text-on-surface text-lg">Profile Picture</h4>
                            <p class="text-sm text-on-surface-variant max-w-sm leading-relaxed">This will be displayed on your portfolio and artwork listings. We recommend a clear, professional photo.</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="block text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Full Name</label>
                            <input type="text" id="inp-name" class="w-full bg-surface border border-outline-variant rounded-xl px-4 py-3 focus:ring-primary focus:border-primary font-body-md" value="<%= user ? user.fullName : '' %>">
                        </div>
                        <div class="space-y-2">
                            <label class="block text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Email Address (Cannot be changed)</label>
                            <input type="email" disabled class="w-full bg-surface-variant/50 border border-outline-variant/50 rounded-xl px-4 py-3 text-on-surface-variant font-body-md cursor-not-allowed" value="<%= user ? user.email : '' %>">
                        </div>
                        <div class="space-y-3">
                            <div class="flex justify-between items-center">
                                <label class="block text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Specializations (Max 3)</label>
                                <span id="spec-counter" class="text-[10px] text-primary font-bold">0/3 Selected</span>
                            </div>
                            <div class="flex flex-wrap gap-2" id="spec-pills">
                                <label class="cursor-pointer">
                                    <input type="checkbox" value="Madhubani" class="peer hidden spec-checkbox">
                                    <div class="px-4 py-2 rounded-full border border-outline-variant text-sm text-on-surface peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary transition-all">Madhubani</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="checkbox" value="Tanjore" class="peer hidden spec-checkbox">
                                    <div class="px-4 py-2 rounded-full border border-outline-variant text-sm text-on-surface peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary transition-all">Tanjore</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="checkbox" value="Warli" class="peer hidden spec-checkbox">
                                    <div class="px-4 py-2 rounded-full border border-outline-variant text-sm text-on-surface peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary transition-all">Warli</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="checkbox" value="Pattachitra" class="peer hidden spec-checkbox">
                                    <div class="px-4 py-2 rounded-full border border-outline-variant text-sm text-on-surface peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary transition-all">Pattachitra</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="checkbox" value="Gond Art" class="peer hidden spec-checkbox">
                                    <div class="px-4 py-2 rounded-full border border-outline-variant text-sm text-on-surface peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary transition-all">Gond Art</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="checkbox" value="Other" class="peer hidden spec-checkbox">
                                    <div class="px-4 py-2 rounded-full border border-outline-variant text-sm text-on-surface peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary transition-all">Other</div>
                                </label>
                            </div>
                            <input type="text" id="inp-other-spec" class="hidden w-full bg-surface border border-outline-variant rounded-xl px-4 py-3 focus:ring-primary focus:border-primary font-body-md mt-3" placeholder="Please specify your specialization...">
                        </div>
                        <div class="space-y-2">
                            <label class="block text-[10px] font-bold uppercase tracking-widest text-on-surface-variant flex items-center justify-between">
                                Region / Location <span class="material-symbols-outlined text-[12px] text-stone-400">lock</span>
                            </label>
                            <input type="text" id="inp-location" placeholder="e.g. Tamil Nadu, India" class="w-full bg-surface border border-outline-variant rounded-xl px-4 py-3 text-stone-500 font-body-md cursor-not-allowed opacity-70" disabled readonly>
                        </div>
                    </div>
                </div>

                <div class="bg-surface-container-lowest border border-outline-variant rounded-3xl p-8 shadow-sm mb-8">
                    <h3 class="font-headline-md text-2xl font-bold mb-6 text-on-surface flex items-center gap-2 border-b border-outline-variant pb-4">
                        <span class="material-symbols-outlined text-primary">account_balance</span> Payout Details
                    </h3>
                    <p class="text-sm text-on-surface-variant mb-6">Connect your bank account to receive payments from collectors directly.</p>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="block text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Bank Name</label>
                            <input type="text" placeholder="e.g. State Bank of India" class="w-full bg-surface border border-outline-variant rounded-xl px-4 py-3 focus:ring-primary focus:border-primary font-body-md">
                        </div>
                        <div class="space-y-2">
                            <label class="block text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Account Number</label>
                            <input type="password" placeholder="••••••••••••" class="w-full bg-surface border border-outline-variant rounded-xl px-4 py-3 focus:ring-primary focus:border-primary font-body-md">
                        </div>
                        <div class="space-y-2 md:col-span-2">
                            <label class="block text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">IFSC Code</label>
                            <input type="text" placeholder="e.g. SBIN0001234" class="w-full bg-surface border border-outline-variant rounded-xl px-4 py-3 focus:ring-primary focus:border-primary font-body-md">
                        </div>
                    </div>
                </div>

                <div class="flex justify-end gap-4">
                    <button class="px-8 py-4 border border-outline-variant text-on-surface font-bold uppercase tracking-widest text-xs rounded-xl hover:bg-surface-container-low transition-colors">Discard</button>
                    <button onclick="saveProfile()" class="px-10 py-4 bg-primary text-on-primary font-bold uppercase tracking-widest text-xs rounded-xl hover:brightness-110 transition-all shadow-xl flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg">save</span> Save Changes
                    </button>
                </div>
            </div>
            <div class="h-10"></div>
        </div>
    </main>

    <script>
        let currentProfilePic = null;

        function previewProfilePic(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (event) => {
                    currentProfilePic = event.target.result;
                    document.getElementById('profile-preview').src = currentProfilePic;
                };
                reader.readAsDataURL(file);
            }
        }

        function loadProfile() {
            let email = 'unknown';
            try {
                const user = JSON.parse(localStorage.getItem('currentUser') || '{}');
                email = user.email || 'unknown';
                if (!document.getElementById('inp-name').value && user.fullName) {
                    document.getElementById('inp-name').value = user.fullName;
                }
                if (user.location) {
                    document.getElementById('inp-location').value = user.location;
                }
            } catch(e) {}

            const saved = localStorage.getItem('artist_profile_' + email);
            if (saved) {
                try {
                    const data = JSON.parse(saved);
                    if (data.displayName) document.getElementById('inp-name').value = data.displayName;
                    if (data.location) document.getElementById('inp-location').value = data.location;
                    if (data.specialization) {
                        const specs = data.specialization.split(',').map(s => s.trim());
                        const knownSpecs = ['Madhubani', 'Tanjore', 'Warli', 'Pattachitra', 'Gond Art', 'Other'];
                        
                        document.querySelectorAll('.spec-checkbox').forEach(cb => {
                            if (cb.value !== 'Other' && specs.includes(cb.value)) cb.checked = true;
                        });
                        
                        const otherValues = specs.filter(s => !knownSpecs.includes(s));
                        if (specs.includes('Other') || otherValues.length > 0) {
                            const otherCb = document.querySelector('input[value="Other"]');
                            if(otherCb) otherCb.checked = true;
                            const otherInp = document.getElementById('inp-other-spec');
                            otherInp.classList.remove('hidden');
                            if (otherValues.length > 0) otherInp.value = otherValues.join(', ');
                        }
                        updateSpecCounter();
                    }
                    if (data.photoUrl) {
                        currentProfilePic = data.photoUrl;
                        document.getElementById('profile-preview').src = data.photoUrl;
                    }
                } catch(e) {}
            }
        }

        async function saveProfile() {
            let email = 'unknown';
            try {
                const user = JSON.parse(localStorage.getItem('currentUser') || '{}');
                email = user.email || 'unknown';
            } catch(e) {}

            const checkedSpecs = Array.from(document.querySelectorAll('.spec-checkbox:checked')).map(cb => cb.value);
            
            let finalSpecs = [];
            checkedSpecs.forEach(spec => {
                if (spec === 'Other') {
                    const otherVal = document.getElementById('inp-other-spec').value.trim();
                    if (otherVal) finalSpecs.push(otherVal);
                    else finalSpecs.push('Other');
                } else {
                    finalSpecs.push(spec);
                }
            });

            const btn = document.querySelector('button[onclick="saveProfile()"]');
            const ogHtml = btn.innerHTML;
            btn.innerHTML = '<span class="material-symbols-outlined animate-spin">refresh</span> Saving...';

            const data = {
                displayName: document.getElementById('inp-name').value,
                specialization: finalSpecs.join(', '),
                location: document.getElementById('inp-location').value,
                photoUrl: currentProfilePic || document.getElementById('profile-preview').src
            };

            // Sync to backend
            try {
                await fetch('/auth/artist/profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
            } catch (err) {
                console.error("Failed to sync profile to backend", err);
            }

            localStorage.setItem('artist_profile_' + email, JSON.stringify(data));
            
            // Also update currentUser globally if they change name
            try {
                const user = JSON.parse(localStorage.getItem('currentUser') || '{}');
                user.fullName = data.displayName;
                user.spec = data.specialization;
                localStorage.setItem('currentUser', JSON.stringify(user));
            } catch(e) {}

            btn.innerHTML = '<span class="material-symbols-outlined">check</span> Saved!';
            btn.classList.replace('bg-primary', 'bg-green-600');
            
            // Re-render sidebar to reflect changes immediately
            const sidebar = document.querySelector('dashboard-sidebar');
            if(sidebar) sidebar.connectedCallback();

            setTimeout(() => {
                btn.innerHTML = ogHtml;
                btn.classList.replace('bg-green-600', 'bg-primary');
            }, 2000);
        }

        function updateSpecCounter() {
            const checked = document.querySelectorAll('.spec-checkbox:checked').length;
            document.getElementById('spec-counter').textContent = `${checked}/3 Selected`;
        }

        function initSpecLimit() {
            const checkboxes = document.querySelectorAll('.spec-checkbox');
            checkboxes.forEach(cb => {
                cb.addEventListener('change', function() {
                    const checkedCount = document.querySelectorAll('.spec-checkbox:checked').length;
                    if (checkedCount > 3) {
                        this.checked = false; // revert
                        alert('You can only select up to 3 specializations.');
                    }
                    
                    if (this.value === 'Other') {
                        const otherInp = document.getElementById('inp-other-spec');
                        if (this.checked) otherInp.classList.remove('hidden');
                        else otherInp.classList.add('hidden');
                    }
                    
                    updateSpecCounter();
                });
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            initSpecLimit();
            loadProfile();
        });
    </script>
</body>
</html>