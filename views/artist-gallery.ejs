<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Manage Gallery | The Painted Muse</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Outfit:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="components/DashboardNavbar.js" defer></script>
    <script>
        tailwind.config = { darkMode: "class", theme: { extend: { colors: { "on-background": "#241915", outline: "#8b7169", "outline-variant": "#dfc0b6", "surface-bright": "#fff8f6", surface: "#fff8f6", "surface-container-low": "#fff1ed", primary: "#942e02", background: "#fff8f6", "on-surface": "#241915", "surface-container": "#ffe9e3", "on-primary": "#ffffff", secondary: "#795900", "primary-container": "#b5451b", "surface-variant": "#f4ded7", "on-primary-container": "#ffe4dc", "surface-container-highest": "#f4ded7", "surface-container-lowest": "#ffffff" }, fontFamily: { "label-sm": ["Outfit"], "headline-lg": ["Cormorant Garamond"], "headline-md": ["Cormorant Garamond"], "body-lg": ["Outfit"], "body-md": ["Outfit"] } } } }
    </script>
    <style>
        body { background: #fff8f6; color: #241915; font-family: 'Outfit', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24 }
        .paper-grain { background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E"); opacity: .03; pointer-events: none; }
        
        .upload-type.active { border-color: #942e02; background: rgba(148, 46, 2, .06); }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #dfc0b6; border-radius: 10px; }
    </style>
</head>
<body class="bg-surface min-h-[100dvh] flex flex-col bg-gradient-to-br from-[#FDFBF7] via-[#F5F0E8] to-[#E8E4D9] relative">
    <dashboard-navbar type="artist"></dashboard-navbar>
    <div class="ink-grain"></div>

    <main class="flex-1 w-full overflow-y-auto custom-scrollbar relative">
        <div class="p-6 md:p-10 space-y-10 max-w-7xl mx-auto w-full">
            <div class="flex flex-col xl:flex-row gap-8 w-full max-w-7xl mx-auto px-6 md:px-10 py-12">
                <div class="flex-1">
                    <header class="mb-8">
                        <h1 class="font-headline-lg text-on-background text-4xl mb-2 font-bold">New Masterpiece</h1>
                        <p class="font-body-lg text-on-surface-variant">Upload high-res art to your gallery to showcase to collectors.</p>
                    </header>

                    <!-- Upload Form -->
                    <div class="flex flex-col items-center gap-6 border-2 border-dashed border-outline-variant bg-surface-container-lowest px-6 py-12 rounded-2xl group hover:border-primary transition-colors cursor-pointer mb-8" onclick="document.getElementById('fileInput').click()">
                        <div class="bg-surface-container p-4 rounded-full group-hover:bg-primary-container transition-colors">
                            <span class="material-symbols-outlined text-primary text-4xl group-hover:text-on-primary transition-colors" id="dropzone-icon">add_photo_alternate</span>
                        </div>
                        <div class="text-center">
                            <p class="text-on-surface font-headline-md text-xl font-bold" id="dropzone-title">Click to upload artwork</p>
                            <p class="text-on-surface-variant font-body-md text-sm mt-1" id="dropzone-desc">PNG, JPG recommended.</p>
                        </div>
                        <input type="file" id="fileInput" accept="image/*" class="hidden" onchange="handleFileSelect(event)" />
                        <p id="file-name" class="text-sm text-primary font-bold hidden bg-primary/10 px-4 py-2 rounded-full"></p>
                    </div>

                    <div class="bg-surface-container-lowest border border-outline-variant p-8 rounded-2xl grid grid-cols-1 md:grid-cols-2 gap-8 mb-8 shadow-sm">
                        <div class="flex flex-col gap-2">
                            <label class="font-label-sm text-on-surface uppercase tracking-widest text-[10px] font-bold">Title</label>
                            <input id="inp-title" oninput="updatePreview()" class="bg-transparent border-b border-outline-variant text-on-surface focus:border-primary focus:ring-0 px-0 py-3 font-headline-md text-xl placeholder:text-outline-variant/50 transition-colors" placeholder="e.g. Eternal Echoes" type="text" />
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="font-label-sm text-on-surface uppercase tracking-widest text-[10px] font-bold">Price (₹)</label>
                            <div class="relative">
                                <span class="absolute left-0 top-1/2 -translate-y-1/2 font-headline-md text-xl text-on-surface-variant">₹</span>
                                <input id="inp-price" oninput="updatePreview()" class="bg-transparent border-b border-outline-variant text-on-surface focus:border-primary focus:ring-0 pl-6 py-3 w-full font-headline-md text-xl placeholder:text-outline-variant/50 transition-colors" placeholder="0" type="number" />
                            </div>
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="font-label-sm text-on-surface uppercase tracking-widest text-[10px] font-bold">Status</label>
                            <select id="inp-status" class="bg-surface-bright border border-outline-variant text-on-surface focus:border-primary focus:ring-0 px-4 py-3 font-body-lg cursor-pointer rounded-xl">
                                <option value="Available">Available for Sale</option>
                                <option value="Reserved">Reserved</option>
                                <option value="Sold">Sold / Not for Sale</option>
                            </select>
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="font-label-sm text-on-surface uppercase tracking-widest text-[10px] font-bold">Category</label>
                            <select id="inp-category" onchange="updatePreview()" class="bg-surface-bright border border-outline-variant text-on-surface focus:border-primary focus:ring-0 px-4 py-3 font-body-lg cursor-pointer rounded-xl">
                                <option value="Madhubani">Madhubani</option>
                                <option value="Tanjore">Tanjore</option>
                                <option value="Warli">Warli</option>
                                <option value="Pattachitra">Pattachitra</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="md:col-span-2 flex flex-col gap-2">
                            <label class="font-label-sm text-on-surface uppercase tracking-widest text-[10px] font-bold">Artisan's Note</label>
                            <textarea id="inp-desc" oninput="updatePreview()" class="bg-transparent border border-outline-variant text-on-surface focus:border-primary focus:ring-0 p-4 font-body-md placeholder:text-outline-variant/50 resize-none rounded-xl transition-colors" placeholder="Describe the medium, inspiration..." rows="3"></textarea>
                        </div>
                    </div>
                    
                    <div class="flex justify-end">
                        <button onclick="publishItem()" class="h-14 px-10 bg-primary text-on-primary font-body-md font-bold uppercase tracking-widest hover:brightness-110 transition-all shadow-xl rounded-xl flex items-center gap-2">
                            <span class="material-symbols-outlined">publish</span> Publish to Gallery
                        </button>
                    </div>

                    <!-- Existing Gallery Grid -->
                    <div class="mt-16 border-t border-outline-variant pt-12">
                        <h2 class="font-headline-lg text-on-background text-3xl mb-8 font-bold">Your Gallery</h2>
                        <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                            <!-- Injected by JS -->
                            <div class="col-span-full py-10 text-center text-on-surface-variant">Loading gallery...</div>
                        </div>
                    </div>
                </div>

                <!-- Live Preview Sidebar -->
                <div class="w-full xl:w-96 xl:sticky xl:top-8 xl:self-start">
                    <h3 class="font-label-sm text-on-surface uppercase tracking-widest mb-6 font-bold">Live Preview</h3>
                    <div class="border border-outline-variant bg-surface-container-lowest rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
                        <div class="aspect-square bg-surface-variant relative overflow-hidden group">
                            <div class="absolute inset-0 flex items-center justify-center text-outline-variant" id="preview-placeholder">
                                <span class="material-symbols-outlined text-6xl opacity-50">image</span>
                            </div>
                            <img id="preview-img" class="w-full h-full object-cover hidden transition-transform duration-700 group-hover:scale-105" src="" />
                        </div>
                        <div class="p-6">
                            <div class="flex justify-between items-start mb-2">
                                <h4 class="font-headline-md text-2xl font-bold truncate" id="preview-title">Untitled Work</h4>
                                <span class="text-primary font-bold text-lg" id="preview-price">₹0</span>
                            </div>
                            <p class="font-label-sm text-primary uppercase tracking-widest mb-4 text-[10px] font-bold" id="preview-cat">Madhubani</p>
                            <div class="h-[1px] w-full bg-outline-variant/50 mb-4"></div>
                            <p class="font-body-md text-on-surface-variant italic text-sm line-clamp-3 leading-relaxed" id="preview-desc">Your artwork's story will appear here.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="h-10"></div>
        </div>
    </main>

    <script>
        let currentFileUrl = null;
        let currentFile = null;

        function handleFileSelect(e) {
            const file = e.target.files[0];
            if (!file) return;
            currentFile = file;
            
            const nameEl = document.getElementById('file-name');
            nameEl.textContent = file.name;
            nameEl.classList.remove('hidden');
            
            const reader = new FileReader();
            reader.onload = (event) => {
                currentFileUrl = event.target.result;
                const prevImg = document.getElementById('preview-img');
                const placeholder = document.getElementById('preview-placeholder');
                
                prevImg.src = currentFileUrl;
                prevImg.classList.remove('hidden');
                placeholder.classList.add('hidden');
            };
            reader.readAsDataURL(file);
        }

        function updatePreview() {
            const t = document.getElementById('inp-title').value;
            const p = document.getElementById('inp-price').value;
            const c = document.getElementById('inp-category').value;
            const d = document.getElementById('inp-desc').value;
            
            document.getElementById('preview-title').textContent = t || 'Untitled Work';
            document.getElementById('preview-price').textContent = p ? '₹' + Number(p).toLocaleString('en-IN') : '₹0';
            document.getElementById('preview-cat').textContent = c || 'Madhubani';
            document.getElementById('preview-desc').textContent = d || "Your artwork's story will appear here.";
        }

        async function fetchGallery() {
            try {
                const res = await fetch('/api/artworks/me');
                const data = await res.json();
                const grid = document.getElementById('gallery-grid');
                grid.innerHTML = '';
                
                if (data.success && data.artworks && data.artworks.length > 0) {
                    data.artworks.forEach(art => {
                        grid.innerHTML += `
                            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl overflow-hidden group">
                                <div class="aspect-square bg-surface-variant overflow-hidden relative">
                                    <img src="${art.imageUrl || 'https://placehold.co/400x400/F5F0E8/B5451B?text=Artwork'}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                    <div class="absolute top-3 right-3 bg-white/90 backdrop-blur px-2 py-1 rounded text-[9px] font-bold text-on-surface uppercase tracking-widest">${art.status}</div>
                                </div>
                                <div class="p-4">
                                    <h4 class="font-headline-md text-lg font-bold truncate">${art.title}</h4>
                                    <div class="flex justify-between items-center mt-1">
                                        <span class="text-[10px] uppercase tracking-widest text-on-surface-variant font-bold">${art.category}</span>
                                        <span class="text-sm font-bold text-primary">₹${Number(art.price).toLocaleString('en-IN')}</span>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                } else {
                    grid.innerHTML = '<div class="col-span-full py-10 text-center text-on-surface-variant font-medium">No artworks in your gallery yet. Upload one above!</div>';
                }
            } catch(e) {
                console.error("Gallery fetch failed", e);
            }
        }

        async function publishItem() {
            const title = document.getElementById('inp-title').value.trim();
            const price = document.getElementById('inp-price').value;
            const status = document.getElementById('inp-status').value;
            const category = document.getElementById('inp-category').value;
            const desc = document.getElementById('inp-desc').value.trim();

            if (!title) return alert('Please enter a title for your masterpiece.');
            if (!currentFileUrl) return alert('Please upload an image.');

            const btn = document.querySelector('button[onclick="publishItem()"]');
            const ogHtml = btn.innerHTML;
            btn.innerHTML = '<span class="material-symbols-outlined animate-spin">sync</span> Publishing...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/artworks', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, price, status, category, description: desc, imageUrl: currentFileUrl })
                });
                const data = await res.json();
                
                if (data.success) {
                    alert('Successfully published to your Gallery!');
                    // Reset form
                    document.getElementById('inp-title').value = '';
                    document.getElementById('inp-price').value = '';
                    document.getElementById('inp-desc').value = '';
                    currentFileUrl = null;
                    currentFile = null;
                    document.getElementById('file-name').classList.add('hidden');
                    document.getElementById('preview-img').classList.add('hidden');
                    document.getElementById('preview-placeholder').classList.remove('hidden');
                    updatePreview();
                    fetchGallery(); // Refresh gallery
                } else {
                    alert('Failed to publish: ' + data.message);
                }
            } catch (err) {
                console.error(err);
                alert('Connection error.');
            } finally {
                btn.innerHTML = ogHtml;
                btn.disabled = false;
            }
        }

        document.addEventListener('DOMContentLoaded', fetchGallery);
    </script>
</body>
</html>