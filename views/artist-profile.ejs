<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />
<title>Artist Profile | The Painted Muse</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script src="/components/Navbar.js" defer></script>
<script src="/components/Footer.js" defer></script>
<link
href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&family=Outfit:wght@300;400;500;700&family=Great+Vibes&display=swap"
rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
rel="stylesheet" />
<script>
tailwind.config = {
darkMode: "class",
theme: {
extend: {
colors: {
primary: "#B5451B",
accent: "#D4AF37",
background: "#FDFBF7",
text: "#1A1208",
cream: "#F5F0E8",
border: "rgba(212, 175, 55, 0.2)",
},
fontFamily: {
serif: ["Cormorant Garamond", "serif"],
sans: ["Outfit", "sans-serif"],
calligraphy: ["Great Vibes", "cursive"]
}
}
}
}
</script>
<style>
body {
background-color: #FDFBF7;
color: #1A1208;
font-family: 'Outfit', sans-serif;
height: 100vh;
overflow: hidden;
}
.paper-grain {
background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
opacity: 0.035;
pointer-events: none;
}
.custom-scrollbar::-webkit-scrollbar {
width: 6px;
height: 6px;
}
.custom-scrollbar::-webkit-scrollbar-track {
background: rgba(26, 18, 8, 0.05);
}
.custom-scrollbar::-webkit-scrollbar-thumb {
background: #D4AF37;
border-radius: 9999px;
}
.warli-border {
border: 1px solid rgba(212, 175, 55, 0.35);
position: relative;
}
.warli-border::before {
content: "";
position: absolute;
inset: 4px;
border: 1px solid rgba(212, 175, 55, 0.15);
pointer-events: none;
}
.glass-panel {
background: rgba(255, 255, 255, 0.72);
backdrop-filter: blur(12px);
-webkit-backdrop-filter: blur(12px);
border: 1px solid rgba(212, 175, 55, 0.15);
}
</style>
</head>
<body class="bg-background">
<div class="fixed inset-0 paper-grain z-50 pointer-events-none"></div>
<div class="relative flex h-screen w-full flex-col overflow-hidden">
<main class="flex-1 flex flex-col min-w-0 h-screen overflow-y-auto custom-scrollbar">
<header class="sticky top-0 z-40 bg-white/80 backdrop-blur-md border-b border-stone-200 px-8 py-4 flex justify-between items-center">
<h1 class="font-serif text-2xl text-text">Artist <span class="italic text-primary">Profile</span></h1>
<div class="flex items-center gap-4">
<button onclick="window.history.length > 1 ? window.history.back() : window.location.href='/artists'" class="text-stone-500 hover:text-primary transition-colors flex items-center gap-1">
<span class="material-symbols-outlined text-xl">arrow_back</span> Back
</button>
</div>
</header>
<div id="portfolio-showcase-container" class="transition-colors duration-500 w-full min-h-[calc(100vh-73px)] pb-12">
<div class="relative h-64 w-full bg-cream overflow-hidden">
<div id="showcase-cover-pattern" class="absolute inset-0 opacity-[0.08] pointer-events-none bg-cover bg-center" style="background-image: url('/pics/warli_pattern_1778230295803.png');"></div>
<div class="absolute inset-0 bg-gradient-to-t from-black/45 via-transparent to-transparent"></div>
</div>
<div class="max-w-5xl mx-auto px-8 -mt-56 relative z-10 space-y-12">
<div class="glass-panel p-8 rounded-2xl flex flex-col md:flex-row gap-8 items-center md:items-start shadow-xl">
<div class="size-32 rounded-2xl overflow-hidden border-4 border-[#D4AF37]/45 shadow-md flex-shrink-0 bg-white">
<img id="showcase-avatar" class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&q=80&w=400" />
</div>
<div class="text-center md:text-left flex-1 space-y-3">
<div class="flex flex-col sm:flex-row items-center gap-2 justify-center md:justify-start">
<h2 id="showcase-name" class="font-serif text-3xl font-bold tracking-tight text-text">Loading...</h2>
<span class="font-calligraphy text-2xl text-primary transform translate-y-1">Artistic Excellence</span>
</div>
<p id="showcase-spec" class="text-primary font-bold text-xs uppercase tracking-widest">Master Artisan</p>
<p class="text-text/70 text-xs flex items-center justify-center md:justify-start gap-1">
<span class="material-symbols-outlined text-sm">location_on</span> <span id="showcase-location">India</span>
</p>
<div class="flex flex-wrap gap-4 justify-center md:justify-start pt-4">
<button id="btn-chat" class="bg-primary text-white px-6 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider shadow-lg hover:brightness-110 transition-all flex items-center gap-2">
<span class="material-symbols-outlined text-sm font-bold">chat</span> Chat with Artist
</button>
<button id="btn-commission" class="bg-[#F5F0E8] text-primary border border-primary/30 px-6 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider shadow-sm hover:bg-primary/5 transition-all flex items-center gap-2">
<span class="material-symbols-outlined text-sm font-bold">palette</span> Commission / Hire
</button>
</div>
</div>
<div class="border-t md:border-t-0 md:border-l border-border/40 pt-6 md:pt-0 md:pl-8 flex flex-row md:flex-col gap-6 justify-center text-center">
<div>
<h5 class="text-[10px] font-bold uppercase tracking-widest text-text/45">Artworks</h5>
<p id="artworks-count" class="font-serif text-2xl text-primary font-bold">0</p>
</div>
<div>
<h5 class="text-[10px] font-bold uppercase tracking-widest text-text/45">Rating</h5>
<p class="font-serif text-2xl text-primary font-bold">4.9</p>
</div>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
<div class="glass-panel p-8 rounded-2xl shadow-md space-y-4 relative overflow-hidden">
<div class="absolute inset-0 opacity-[0.08] pointer-events-none bg-cover bg-center" style="background-image: url('/pics/warli_pattern_1778230295803.png');"></div>
<h3 class="font-serif text-xl font-bold border-b border-border/30 pb-2 text-text relative z-10">Artist Biography</h3>
<p class="text-sm text-text/80 leading-relaxed italic relative z-10">
"Crafting heritage art forms with meticulous devotion. Every stroke preserves our ancient traditions and brings them to the modern world."
</p>
</div>
<div class="glass-panel p-8 rounded-2xl shadow-md space-y-4 relative overflow-hidden">
<div class="absolute inset-0 opacity-[0.08] pointer-events-none bg-cover bg-center" style="background-image: url('/pics/warli_pattern_1778230295803.png');"></div>
<h3 class="font-serif text-xl font-bold border-b border-border/30 pb-2 text-text relative z-10">Exhibitions & Milestones</h3>
<ul class="space-y-3 text-sm text-text/80 leading-relaxed relative z-10">
<li class="flex items-start gap-2.5"><span class="text-primary mt-1">•</span><span>Solo Exhibition, Visual Arts Gallery, New Delhi (2023)</span></li>
<li class="flex items-start gap-2.5"><span class="text-primary mt-1">•</span><span>State Award for Traditional Crafts (2021)</span></li>
<li class="flex items-start gap-2.5"><span class="text-primary mt-1">•</span><span>National Traditional Conclave Participant (2020)</span></li>
</ul>
</div>
</div>
<div class="space-y-6">
<div class="space-y-4 pt-2">
<div class="flex items-center justify-between border-b border-border/30 pb-3">
<h3 class="font-serif text-2xl font-bold text-text">Portfolio Collection</h3>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="artworks-grid">
<!-- Artworks loaded dynamically -->
</div>
</div>
</div>
</div>
</main>
</div>
<script>
const artistId = '<%= artistId %>';

async function loadProfile() {
    try {
        const [artistRes, artworksRes] = await Promise.all([
            fetch('/api/artists/' + artistId),
            fetch('/api/artworks/artist/' + artistId)
        ]);
        
        const artistData = await artistRes.json();
        const artworksData = await artworksRes.json();
        
        if (artistData.success) {
            const artist = artistData.artist;
            document.getElementById('showcase-name').textContent = artist.fullName;
            document.getElementById('showcase-spec').textContent = artist.specialization + ' Master Artisan';
            document.getElementById('showcase-location').textContent = artist.location;
            
            document.getElementById('btn-chat').onclick = () => window.location.href = '/chat?artistId=' + artist._id;
            document.getElementById('btn-commission').onclick = () => window.location.href = '/payment?item=' + encodeURIComponent('Commission: ' + artist.fullName) + '&price=5000';
        }
        
        if (artworksData.success) {
            document.getElementById('artworks-count').textContent = artworksData.artworks.length;
            const grid = document.getElementById('artworks-grid');
            grid.innerHTML = '';
            
            if (artworksData.artworks.length === 0) {
                grid.innerHTML = '<p class="col-span-2 text-stone-500 italic">This artist has not uploaded any artworks yet.</p>';
            } else {
                artworksData.artworks.forEach(art => {
                    grid.innerHTML += `
                    <div class="warli-border bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 group">
                        <div class="aspect-video bg-cream overflow-hidden relative">
                            <img class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500" src="${art.imageUrl || '/pics/madhubani_bg.png'}" onerror="this.src='/pics/madhubani_bg.png'"/>
                            <span class="absolute top-3 left-3 bg-[#B5451B] text-white text-[9px] font-bold uppercase tracking-widest px-3 py-1 rounded-full shadow-md z-10">${art.status || 'Available'}</span>
                        </div>
                        <div class="p-6">
                            <h4 class="font-serif text-lg font-bold text-text">${art.title}</h4>
                            <div class="flex justify-between items-center mt-3 pt-3 border-t border-border/20">
                                <span class="text-[9px] font-bold uppercase tracking-wider text-text/60">${art.category}</span>
                                <span class="text-primary font-bold text-sm">₹${art.price}</span>
                            </div>
                            <button onclick="window.location.href='/payment?item=' + encodeURIComponent('${art.title}') + '&price=${art.price}'" class="w-full mt-4 py-2 bg-[#F5F0E8] text-primary text-[10px] font-bold uppercase tracking-widest rounded hover:bg-[#D4AF37] hover:text-white transition-all flex items-center justify-center gap-1">Buy Artwork <span class="material-symbols-outlined text-[12px]">shopping_bag</span></button>
                        </div>
                    </div>
                    `;
                });
            }
        }
    } catch (e) {
        console.error(e);
    }
}

document.addEventListener('DOMContentLoaded', loadProfile);
</script>
<script src="/content-loader.js"></script>
</body>
</html>