<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Workshops | The Painted Muse</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&family=Outfit:wght@400;500;700&family=Great+Vibes&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="components/DashboardNavbar.js" defer></script>
    <style>
        :root {
            --primary: #B5451B;
            --accent: #D4AF37;
            --background: #FDFBF7;
            --text: #1A1208;
            --cream: #F5F0E8;
            --warm: #FFF8F0;
        }
        .material-symbols-outlined {
            font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24
        }
        body {
            background-color: var(--background);
            color: var(--text);
            font-family: 'Outfit', sans-serif;
        }
        .font-serif { font-family: 'Cormorant Garamond', serif; }
        
        .ink-grain {
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
            opacity: 0.04;
            pointer-events: none;
            position: fixed;
            inset: 0;
            z-index: 99;
        }

        .warli-border {
            border: 1px solid rgba(212, 175, 55, 0.2);
            position: relative;
        }
        .warli-border::before {
            content: "";
            position: absolute;
            inset: 4px;
            border: 1px solid rgba(212, 175, 55, 0.1);
            pointer-events: none;
        }

        @keyframes pageFadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        main > div {
            animation: pageFadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(26, 18, 8, 0.05); }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 10px; }
    </style>
</head>
<body class="min-h-[100dvh] flex flex-col bg-gradient-to-br from-[#FDFBF7] via-[#F5F0E8] to-[#E8E4D9] relative">
    <dashboard-navbar type="user"></dashboard-navbar>
    <div class="ink-grain"></div>
        
    <main class="flex-1 w-full overflow-y-auto custom-scrollbar relative">
        <div class="p-6 md:p-10 space-y-10 max-w-7xl mx-auto w-full">
                <div class="bg-[#1A1208] text-white rounded-3xl p-10 relative overflow-hidden shadow-2xl">
                    <div class="absolute inset-0 opacity-30 bg-[url('pics/warli_pattern_1778230295803.png')] bg-cover mix-blend-overlay"></div>
                    <div class="relative z-10">
                        <h1 class="text-4xl font-serif mb-4">Learn from the <span class="text-[#D4AF37] italic">Masters</span></h1>
                        <p class="text-stone-300 max-w-2xl text-lg mb-8">Immerse yourself in centuries-old traditions. Book an exclusive live session with heritage artisans and bring their techniques into your own hands.</p>
                    </div>
                </div>

                <div id="workshops-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
                    <!-- Shimmer Loaders -->
                    <div class="h-96 bg-white rounded-2xl border border-stone-200 overflow-hidden animate-pulse">
                        <div class="h-48 bg-stone-200"></div>
                        <div class="p-6 space-y-4">
                            <div class="h-6 bg-stone-200 rounded w-3/4"></div>
                            <div class="h-4 bg-stone-200 rounded w-1/2"></div>
                            <div class="h-10 bg-stone-200 rounded mt-4"></div>
                        </div>
                    </div>
                </div>
                
                <div class="h-10"></div>
            </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            try {
                const res = await fetch('/api/workshops');
                const data = await res.json();
                const container = document.getElementById('workshops-grid');
                
                if (data.success && data.workshops && data.workshops.length > 0) {
                    container.innerHTML = '';
                    data.workshops.forEach(ws => {
                        const isSoldOut = ws.seatsAvailable && ws.seatsAvailable.toLowerCase().includes('sold out');
                        
                        let btnHtml = '';
                        if (isSoldOut) {
                            btnHtml = `<button class="w-full py-3 bg-stone-100 text-stone-400 text-[10px] font-bold uppercase tracking-widest rounded cursor-not-allowed border border-stone-200">Join Waitlist</button>`;
                        } else {
                            btnHtml = `<button onclick="window.location.href='/payment?item=${encodeURIComponent(ws.title)}&price=${ws.price}'" class="w-full py-3 bg-[#B5451B] text-white text-[10px] font-bold uppercase tracking-widest rounded hover:bg-[#D4AF37] transition-all shadow-md">Register Now (₹${ws.price.toLocaleString('en-IN')})</button>`;
                        }
                        
                        const itemHTML = `
                        <div class="warli-border group bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all flex flex-col h-full">
                            <div class="h-56 overflow-hidden relative">
                                <img src="${ws.imageUrl}" class="w-full h-full object-cover group-hover:scale-105 transition-all duration-700" alt="Workshop">
                                <div class="absolute top-4 right-4 bg-white/90 backdrop-blur px-3 py-1 rounded text-[10px] font-bold text-[#1A1208] shadow-sm uppercase tracking-widest flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[14px] text-[#B5451B]">calendar_month</span> ${ws.startDate}
                                </div>
                            </div>
                            <div class="p-6 flex-1 flex flex-col">
                                <h4 class="text-2xl font-serif mb-3 text-[#1A1208] leading-tight line-clamp-2" title="${ws.title}">${ws.title}</h4>
                                <div class="flex items-center gap-4 text-stone-500 text-xs mb-6 font-medium">
                                    <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-sm text-[#D4AF37]">schedule</span> ${ws.duration}</span>
                                    <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-sm text-[#D4AF37]">groups</span> ${ws.seatsAvailable}</span>
                                </div>
                                <div class="mt-auto">
                                    ${btnHtml}
                                </div>
                            </div>
                        </div>
                        `;
                        container.innerHTML += itemHTML;
                    });
                } else {
                    container.innerHTML = `
                        <div class="col-span-full text-center py-16 bg-white rounded-2xl border border-stone-200">
                            <div class="w-20 h-20 bg-stone-50 rounded-full flex items-center justify-center mx-auto mb-4 border border-stone-100">
                                <span class="material-symbols-outlined text-4xl text-stone-300">event_busy</span>
                            </div>
                            <h4 class="text-xl font-serif text-stone-900 mb-2">No Workshops Available</h4>
                            <p class="text-stone-500 text-sm max-w-sm mx-auto">Our artisans are currently focused on their craft. Check back later for upcoming immersive workshops.</p>
                        </div>
                    `;
                }
            } catch (e) {
                console.error('Failed to fetch workshops', e);
                document.getElementById('workshops-grid').innerHTML = '<p class="text-red-500 text-sm p-4 col-span-full text-center">Failed to load workshops. Please try again.</p>';
            }
        });
    </script>
</body>
</html>